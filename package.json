{
  "name": "github-deco",
  "version": "0.1.0",
  "description": "Embeddable SVG profile cards for GitHub Markdown",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laigit-dot/profile-shop.git"
  },
  "homepage": "https://github.com/laigit-dot/profile-shop#readme",
  "bugs": {
    "url": "https://github.com/laigit-dot/profile-shop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && rm -rf dist && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js"
  },
  "dependencies": {
    "@iconify-json/skill-icons": "^1.2.4",
    "hono": "^4.13.0",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
